---
import { Icon } from "@noorddev/vlak-react";
import { guideUrl, type Client, type Guide } from "../lib/content";

interface Props {
  client: Client;
  guides: Guide[];
}

const { client, guides } = Astro.props;
---

<ol class="rows">
  {
    guides.map((guide) => (
      <li>
        <a class="row" href={guideUrl(client, guide)}>
          <span>
            <span class="row-title">{guide.data.title}</span>
            <span class="row-desc">{guide.data.summary}</span>
          </span>
          <span class="row-meta">
            {guide.data.video && <span>Video</span>}
            {guide.data.video && guide.data.duration && <span aria-hidden="true">·</span>}
            {guide.data.duration && <span>{guide.data.duration}</span>}
            <Icon name="arrow-right" size={12} className="row-go" aria-hidden="true" />
          </span>
        </a>
      </li>
    ))
  }
</ol>
