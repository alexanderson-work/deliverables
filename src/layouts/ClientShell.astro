---
import { Breadcrumbs, Icon, Sidebar, SidebarItem, SidebarLabel, SidebarNav } from "@noorddev/vlak-react";
import { ThemeToggle } from "@noorddev/vlak-react/components/theme-toggle";
import Base from "./Base.astro";
import MobileNav from "../components/MobileNav";
import Search from "../components/Search";
import { clientNav } from "../components/ClientNav";
import { clientUrl, type Client } from "../lib/content";
import { themeCss, themePaper } from "../lib/theme";
import { contactHref, siteTitle, studio } from "../site.config";

interface Props {
  client: Client;
  /** Page title; omit on the overview. */
  title?: string;
  description?: string;
  /** Breadcrumb trail; the client name sits at the left of the header. */
  trail?: { label: string; href?: string }[];
}

const { client, title, description, trail = [{ label: "Overview" }] } = Astro.props;
const home = clientUrl(client);
const current = Astro.url.pathname;
const groups = await clientNav(client);
const here = title ?? "Overview";
const theme = client.data.theme;
const contact = { name: studio.name, photo: studio.photo, href: contactHref(client.data.name) };
---

<Base
  title={`${title ? `${title} · ` : ""}${client.data.name} · ${siteTitle}`}
  description={description}
  fontStylesheet={theme?.font?.stylesheet}
  fontPreload={theme?.font?.preload}
  favicon={theme?.favicon}
  themeCss={themeCss(theme)}
  paper={themePaper(theme)}
>
  <!-- One full-width header, so browsers that tint their toolbar from a pinned header (Safari 26) find it. -->
  <header class="app-top">
    <a class="app-top-name" href={home}>
      {
        theme?.logo ? (
          <>
            <img class="lockup only-light" src={theme.logo.light} alt={client.data.name} />
            <img class="lockup only-dark" src={theme.logo.dark} alt={client.data.name} />
          </>
        ) : (
          client.data.name
        )
      }
    </a>
    <div class="app-top-bar">
      <Breadcrumbs items={trail} />
      <ThemeToggle className="rs-theme-toggle-inline" client:idle transition:persist="theme-toggle" />
    </div>
  </header>
  <div class="mobile-top">
    <MobileNav
      client:media="(max-width: 1023px)"
      clientName={client.data.name}
      home={home}
      here={here}
      current={current}
      groups={groups}
      contact={contact}
      logo={theme?.logo}
    />
  </div>

  <div class="shell">
    <!-- The rail stays mounted from page to page: its scroll, hover, and focus carry over. -->
    <div class="shell-rail" transition:persist={`rail-${client.id}`}>
      <div class="rail-search">
        <button class="search-trigger" type="button" data-search-open aria-haspopup="dialog">
          <Icon name="search" size={16} aria-hidden="true" />
          <span>Search</span>
          <kbd data-search-key aria-hidden="true">⌘K</kbd>
        </button>
      </div>
      <Sidebar>
        <SidebarNav aria-label="Client space">
          {
            groups.map((group) => (
              <>
                {group.label && <SidebarLabel>{group.label}</SidebarLabel>}
                {group.items.map((item) => (
                  <SidebarItem href={item.href} current={item.href === current}>
                    {item.label}
                    {item.href === current && <span class="nav-current" aria-hidden="true" />}
                  </SidebarItem>
                ))}
              </>
            ))
          }
        </SidebarNav>
      </Sidebar>
      <!-- Pinned under the list, as search is above it. -->
      <a class="contact-card" href={contact.href}>
        <img src={contact.photo} alt="" width="32" height="32" />
        <span>
          <strong>{contact.name}</strong>
          <span>Questions? Email me</span>
        </span>
      </a>
    </div>

    <main class="page" id="main">
      <slot />
    </main>
  </div>

  <Search
    client:idle
    transition:persist={`search-${client.id}`}
    index={`${home}search.json`}
    clientName={client.data.name}
  />

  <script is:inline>
    // On a full load, bring the current item into the rail's view before first paint.
    (() => {
      const rail = document.querySelector(".shell-rail .rs-sidebar");
      const item = rail && rail.querySelector('[aria-current="page"]');
      if (item) {
        const r = rail.getBoundingClientRect();
        const i = item.getBoundingClientRect();
        if (i.top < r.top || i.bottom > r.bottom) rail.scrollTop += i.top - r.top - r.height / 2 + i.height / 2;
      }
    })();
  </script>
  <script>
    import { everyPage } from "../lib/page";

    const root = document.documentElement;
    const scroller = () => document.querySelector<HTMLElement>(".shell-rail .rs-sidebar");
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");

    const inView = (rail: HTMLElement, item: Element) => {
      const r = rail.getBoundingClientRect();
      const i = item.getBoundingClientRect();
      return i.top >= r.top && i.bottom <= r.bottom;
    };

    // Bring an item into the rail's view if it's outside it.
    const reveal = (rail: HTMLElement, item: Element, behavior: ScrollBehavior) => {
      if (inView(rail, item)) return;
      const r = rail.getBoundingClientRect();
      const i = item.getBoundingClientRect();
      rail.scrollTo({ top: rail.scrollTop + i.top - r.top - r.height / 2 + i.height / 2, behavior });
    };

    // The marker glides only between items in view; from or to one scrolled
    // out of sight, it fades instead of sliding over the header.
    document.addEventListener("astro:before-preparation", () => {
      const rail = scroller();
      const marker = rail?.querySelector(".nav-current");
      if (rail && marker) marker.classList.toggle("is-offscreen", !inView(rail, marker));
    });

    // The rail carries over to the next page as it is (transition:persist), so it
    // keeps its place; only the current-page state moves, and the marker glides with it.
    let kept: { rail: HTMLElement; scroll: number } | undefined;
    document.addEventListener("astro:before-swap", () => {
      const rail = scroller();
      kept = rail ? { rail, scroll: rail.scrollTop } : undefined;
    });
    document.addEventListener("astro:after-swap", () => {
      const rail = scroller();
      if (!rail) return;
      const persisted = rail === kept?.rail;
      if (persisted) rail.scrollTop = kept!.scroll;
      const marker = rail.querySelector(".nav-current") ?? document.createElement("span");
      marker.className = "nav-current";
      marker.setAttribute("aria-hidden", "true");
      let current: HTMLAnchorElement | undefined;
      for (const link of rail.querySelectorAll<HTMLAnchorElement>("a.rs-sidebar-item")) {
        const here = link.pathname === location.pathname;
        if (here) current = link;
        if (here) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      }
      if (current) {
        current.append(marker);
        marker.classList.toggle("is-offscreen", !inView(rail, current));
        reveal(rail, current, persisted && !still.matches ? "smooth" : "instant");
      } else {
        marker.remove();
      }
    });

    // The "here" crumb fades in once the page title scrolls under the header,
    // the way Vlak's crumb bar does. It starts hidden (Base.astro).
    everyPage((signal) => {
      const title = document.querySelector("main h1");
      if (!title) return;
      const top = parseFloat(getComputedStyle(root).getPropertyValue("--top-h")) || 64;
      const observer = new IntersectionObserver(([entry]) => root.classList.toggle("title-in-view", entry.isIntersecting), {
        rootMargin: `-${top}px 0px 0px 0px`,
      });
      observer.observe(title);
      signal.addEventListener("abort", () => observer.disconnect());
    });
  </script>
</Base>
